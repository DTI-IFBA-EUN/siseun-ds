{
    "spacing": {
        "base": { "$value": "8px", "$type": "spacing" },
        "scale": {
            "default": { "$value": "0px", "$type": "spacing" },
            "half":    { "$value": "calc({spacing.base} * 0.5)", "$type": "spacing" },
            "base":    { "$value": "{spacing.base}", "$type": "spacing" },
            "baseh":    { "$value": "calc({spacing.base} * 1.5)", "$type": "spacing" },
            "2x":    { "$value": "calc({spacing.base} * 2)", "$type": "spacing" },
            "2xh":    { "$value": "calc({spacing.base} * 2.5)", "$type": "spacing" },
            "3x":    { "$value": "calc({spacing.base} * 3)", "$type": "spacing" },
            "3xh":    { "$value": "calc({spacing.base} * 3.5)", "$type": "spacing" },
            "4x":    { "$value": "calc({spacing.base} * 4)", "$type": "spacing" },
            "4xh":    { "$value": "calc({spacing.base} * 4.5)", "$type": "spacing" },
            "5x":    { "$value": "calc({spacing.base} * 5)", "$type": "spacing" },
            "5xh":    { "$value": "calc({spacing.base} * 5.5)", "$type": "spacing" }
            
        }
    }
}