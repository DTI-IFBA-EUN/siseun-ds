{
    "font": {
        "weight": {
            "thin": { "$value": 100, "$type": "fontWeight" }
        },
        "size": {
            "scale": {
                "base": { "$value": "14px", "$type": "dimension" },
                "down": {
                    "01": { "$value": "calc({font.size.scale.base} * 0.833)", "$type": "dimension" }
                }
            }
        }
    }
}